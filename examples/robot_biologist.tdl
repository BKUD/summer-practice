-- Диаграмма классов для варианта: РоботБиолог
-- Сгенерировано yaml_to_tdl.py из model.yaml
-- Цель: показать, что TDL заменяет PlantUML для выдачи лабораторной

КЛАСС РоботБиолог
-- Основной класс робота для варианта Биолог
  АТРИБУТЫ
    - лабиринт : ЛабиринтРоботБиолог
  ОПЕРАЦИИ
    + ПойтиКРастению() : ЯчейкаРоботБиолог
    + ОтойтиБио() : ЯчейкаРоботБиолог
    + СместитьсяВлево() : ЯчейкаРоботБиолог
    + СместитьсяВправо() : ЯчейкаРоботБиолог
    + Подняться() : ЯчейкаРоботБиолог
    + Спуститься() : ЯчейкаРоботБиолог
    + Растение()
    + Пробирка()
КОНЕЦ КЛАСС


КЛАСС ЛабиринтРоботБиолог
-- Лабиринт для робота-биолога
  АТРИБУТЫ
    - ширина : int
    - длина : int
    - ячейки : ЯчейкаРоботБиолог
  ОПЕРАЦИИ
    + ПолучитьСоседнююЯчейку(текущая_ячейка, направление_поиска) : ЯчейкаРоботБиолог
    + ПолучитьИтератор() : Итератор
    + ИнициализироватьЛабиринт(тип_ячейки)
КОНЕЦ КЛАСС


КЛАСС ЯчейкаРоботБиолог
-- Ячейка лабиринта со специализацией под биолога
  АТРИБУТЫ
    + ячейка_робота : bool
    + тип_ячейки : ТипЯчеекБио
КОНЕЦ КЛАСС


КЛАСС Итератор
-- Итератор для обхода
  ОПЕРАЦИИ
    + следующий() : ЯчейкаРоботБиолог
КОНЕЦ КЛАСС


КЛАСС ТипЯчеекБио
-- Типы ячеек для биолога
  АТРИБУТЫ
    + Растение
    + Вода
    + Пробирка
    + Обработано
    + Лаб
    + Финиш
    + Контейнер
КОНЕЦ КЛАСС


КЛАСС ТипНаправленийБиоНапр
-- Направления движения
  АТРИБУТЫ
    + БВперёд
    + БНазад
    + БВлево
    + БВправо
    + ДиагБВ
    + ДиагБН
КОНЕЦ КЛАСС


АССОЦИАЦИЯ
  ЯчейкаРоботБиолог * КОМПОЗИЦИЯ
  --
  ТипЯчеекБио 1
  ИМЯ "содержит"


АССОЦИАЦИЯ
  ЛабиринтРоботБиолог * КОМПОЗИЦИЯ
  --
  ЯчейкаРоботБиолог [1..*]
  ИМЯ "содержит"


АССОЦИАЦИЯ
  РоботБиолог * КОМПОЗИЦИЯ
  --
  ЛабиринтРоботБиолог 1
  ИМЯ "содержит"


РАЗМЕЩЕНИЕ
  РАСПРЕДЕЛИТЬ ПО ГОРИЗОНТАЛИ РоботБиолог ЛабиринтРоботБиолог ЯчейкаРоботБиолог ТипЯчеекБио ШАГ 10
  ПРИВЯЗАТЬ Итератор ЛЕВЕЕ РоботБиолог
  ПРИВЯЗАТЬ ТипНаправленийБиоНапр ВЫШЕ Итератор
КОНЕЦ РАЗМЕЩЕНИЕ

-- Конец генерации для РоботБиолог